    ---
    const year = new Date().getFullYear();
    ---

    <footer class="py-xl px-md border-t border-outline-variant bg-surface">
            <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-xl">
                <div class="flex items-center gap-2">
                    <a class="text-2xl font-black text-brand-red tracking-tighter" href="/"><img src="/logo.svg" alt="Typpy Logo" width="140"></a>
                </div>
                <div class="text-on-surface-variant text-caption">
                    &copy; {year} Typpy Inc. Happy typing.
                </div>
                <div class="flex gap-lg items-center">
                    <a href="/privacy" class="text-on-surface-variant hover:text-brand-red transition-colors text-caption">Privacy</a>
                    <a href="/disclaimer" class="text-on-surface-variant hover:text-brand-red transition-colors text-caption">Disclaimer</a>
                    <a href="/faq" class="material-symbols-outlined text-on-surface-variant hover:text-brand-red transition-colors">help</a>
                </div>
            </div>
        </footer>