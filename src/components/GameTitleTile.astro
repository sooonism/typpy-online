---
const {
  title,
  subtitle = 'Temporary title tile',
  badgeText = 'Coming soon',
  compact = false
} = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden rounded-xl border border-outline-variant bg-[linear-gradient(135deg,#fff0ef_0%,#ffe2df_50%,#fedad7_100%)]',
    compact ? 'h-40' : 'min-h-[260px]'
  ]}
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(183,0,26,0.16),transparent_42%),radial-gradient(circle_at_bottom_left,rgba(0,95,144,0.14),transparent_34%)]"></div>
  <div class:list={['relative flex h-full flex-col justify-between p-6', compact ? 'p-5' : 'p-8']}>
    {badgeText && <span class="text-xs font-semibold uppercase tracking-[0.24em] text-on-surface-variant">{badgeText}</span>}
    <div>
      <div class:list={['font-black tracking-tight text-on-surface', compact ? 'text-3xl' : 'text-5xl sm:text-6xl']}>
        {title}
      </div>
      {subtitle && <p class="mt-3 max-w-xl text-sm text-on-surface-variant sm:text-base">{subtitle}</p>}
    </div>
  </div>
</div>