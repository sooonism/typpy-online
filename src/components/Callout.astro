---
const { variant = 'info' } = Astro.props;
let classes = 'p-4 rounded border my-4';
if (variant === 'info') classes += ' bg-blue-50 border-blue-300 text-blue-800';
else if (variant === 'warning') classes += ' bg-yellow-50 border-yellow-300 text-yellow-800';
else if (variant === 'success') classes += ' bg-green-50 border-green-300 text-green-800';
---

<div class={classes}>
  <slot />
</div>
