---
import Layout from '@/layouts/Bloglayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/news/*.{md,mdx}', { eager: true }) as Record<string, any>;
  return Object.keys(modules).map(path => {
    const fileName = path.split('/').pop() || '';
    const slug = fileName.replace(/\.(md|mdx)$/, '');
    return { params: { slug } };
  });
}

const slug = Astro.params?.slug;
let post = null;
if (slug) {
  const modules = import.meta.glob('../../content/news/*.{md,mdx}', { eager: true }) as Record<string, any>;
  const entry = Object.entries(modules).find(([path]) => {
    const fileName = path.split('/').pop() || '';
    return fileName.replace(/\.(md|mdx)$/, '') === slug;
  });
  if (entry) {
    const [, mod] = entry;
    post = {
      slug,
      ...(mod.frontmatter || {}),
      Content: mod.default
    };
  }
}
const Content = post ? post.Content : null;
const pageTitle = post?.title ? `${post.title} — Typpy` : 'Post not found — Typpy';
const pageDescription = post?.excerpt || 'Read the latest Typpy news and typing insights.';
const pageUrl = slug ? `https://typpy.online/blog/${slug}` : 'https://typpy.online/blog';
const pageImage = post?.image ? (post.image.match(/^https?:\/\//) ? post.image : `https://typpy.online${post.image}`) : 'https://typpy.online/og/default.png';
const pageSchema = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: pageDescription,
  datePublished: post.date,
  author: {
    '@type': 'Person',
    name: post.author || 'Typpy Team'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Typpy',
    logo: {
      '@type': 'ImageObject',
      url: 'https://typpy.online/logo.svg'
    }
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  image: pageImage
} : null;
---

<Layout title={pageTitle} description={pageDescription} url={pageUrl} image={pageImage} schema={pageSchema} noindex={!post}>
  <main class="max-w-4xl mx-auto px-6 py-12 post">
    {post ? (
      <article class="prose mx-auto">
        <h1>{post.title}</h1>
        <p class="text-sm text-gray-600">{post.date}{post.author ? ` — ${post.author}` : ''}</p>
        <div>
          <Content />
        </div>
      </article>
    ) : (
      <div class="text-center py-20">
        <h2 class="text-2xl font-bold">Post not found</h2>
        <p>The post you requested could not be found.</p>
      </div>
    )}
  </main>
<style>
  .post h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .post h2 {
    font-size: 2rem !important;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .post h3 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .post p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .post a {
    color: #3b82f6;
    text-decoration: underline;
  }
  .post img {
    max-width: 100%;    
  }

</style>