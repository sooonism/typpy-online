---
import Layout from '@/layouts/Layout.astro';

const title = 'Typpy Mission — Happy Typing';
const description = 'The heart of Typpy: happy typing, Typing Solitaire, and a calmer, more human way to practice at the keyboard.';
const url = 'https://typpy.online/mission';

const principles = [
  {
    title: 'The pressure is off',
    body: 'No heart-pounding timers. No red panic bars. Just you, the words, and a little room to breathe.'
  },
  {
    title: 'The vibe is right',
    body: 'A clean, aesthetic interface that respects your focus and makes the act of typing feel good again.'
  },
  {
    title: 'The joy is central',
    body: 'Short, beautiful bursts of text designed to help you smile, settle in, and find your rhythm.'
  }
];

const audience = [
  'artisans of the digital world',
  'writers',
  'late-night coders',
  'casual browsers'
];
---

<Layout title={title} description={description} url={url}>
  <main class="flex-grow w-full px-6 md:px-12 py-section">
    <div class="max-w-6xl mx-auto space-y-8 md:space-y-12 pt-16 md:pt-24">
      <section class="hero-panel rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low">
        <div class="grid lg:grid-cols-[1.35fr_0.85fr] gap-0">
          <div class="p-8 md:p-12 lg:p-16">
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
              <span class="material-symbols-outlined text-[18px]">favorite</span>
              The Heart of Typpy
            </div>

            <p class="text-sm md:text-base uppercase tracking-[0.28em] text-on-surface-variant mb-4">
              Our motto: Happy Typing.
            </p>

            <h1 class="text-5xl md:text-7xl font-black tracking-tight text-on-surface mb-6 leading-[0.95]">
              Happy <span class="text-brand-red italic">Typing</span>.
            </h1>

            <p class="text-lg md:text-2xl text-on-surface-variant max-w-3xl leading-relaxed mb-5">
              Most typing platforms feel like a digital treadmill. There&apos;s a ticking clock, a red error bar,
              and constant pressure to go faster, harder, and more productive.
            </p>
            <p class="text-xl md:text-3xl font-semibold text-on-surface mb-8 max-w-3xl leading-snug">
              But why does typing have to be a race?
            </p>

            <div class="quote-card rounded-[1.5rem] p-6 md:p-7 mb-8">
              <p class="text-lg md:text-xl text-on-surface leading-relaxed">
                At Typpy, we believe the keyboard is an <span class="text-brand-red font-bold">instrument</span>,
                not just a tool. We&apos;re moving away from the stress of the test and leaning into the joy of the
                <span class="italic font-semibold">flow</span>.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 items-center">
              <a
                href="/"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-red text-white font-bold shadow-md hover:-translate-y-0.5 transition-transform"
              >
                <span class="material-symbols-outlined text-[18px]">play_arrow</span>
                Try Typpy
              </a>
              <div class="mono inline-flex items-center px-5 py-3 rounded-xl border border-outline-variant bg-white text-on-surface-variant">
                <span>typpy --happy-typing</span>
                <span class="typing-cursor"></span>
              </div>
            </div>
          </div>

          <div class="hero-side p-8 md:p-12 lg:p-16 flex items-center">
            <div class="space-y-4 w-full">
              <div class="mini-card rounded-[1.5rem] p-6 border border-white/40">
                <div class="flex items-center gap-3 mb-3 text-on-surface">
                  <span class="material-symbols-outlined text-brand-red">style</span>
                  <h2 class="text-xl font-bold">Typing Solitaire</h2>
                </div>
                <p class="text-on-surface-variant leading-relaxed">
                  Treat your keyboard like a deck of cards: tactile, private, calming, and strangely satisfying.
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-4">
                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                  <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">No boss</p>
                  <p class="font-semibold text-on-surface">No one watching your hands.</p>
                </div>
                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                  <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">No stopwatch</p>
                  <p class="font-semibold text-on-surface">No pressure to perform.</p>
                </div>
                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                  <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">Just rhythm</p>
                  <p class="font-semibold text-on-surface">The click, the flow, the screen.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="grid lg:grid-cols-[0.9fr_1.1fr] gap-6 md:gap-8 items-start">
        <div class="section-card rounded-[2rem] p-8 md:p-10 border border-outline-variant bg-white sticky top-24">
          <div class="inline-flex items-center gap-2 text-primary font-semibold mb-4">
            <span class="material-symbols-outlined">wb_sunny</span>
            <span>What is Typing Solitaire?</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-on-surface mb-4">
            A slow Sunday for your hands.
          </h2>
          <p class="text-on-surface-variant leading-relaxed text-lg">
            Think of shuffling a deck of cards or putting together a puzzle. You don&apos;t do it for a trophy.
            You do it because the rhythm feels good.
          </p>
        </div>

        <div class="grid gap-5">
          <article class="section-card rounded-[2rem] p-8 md:p-10 border border-outline-variant bg-surface-container-low">
            <p class="text-lg md:text-xl text-on-surface leading-relaxed mb-5">
              That is <span class="font-bold text-brand-red">Typing Solitaire</span>.
            </p>
            <p class="text-on-surface-variant leading-relaxed mb-4">
              It&apos;s the simple, tactile pleasure of a key bottoming out, the satisfying click-clack of a
              mechanical switch, and the way words look as they bloom across your screen.
            </p>
            <p class="text-on-surface-variant leading-relaxed">
              We aren&apos;t here to help you win a trophy. We&apos;re here to help you find your rhythm.
            </p>
          </article>

          <div class="grid md:grid-cols-3 gap-5">
            <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
              <span class="material-symbols-outlined text-brand-red mb-3">keyboard</span>
              <h3 class="font-bold text-on-surface mb-2">Tactile</h3>
              <p class="text-sm text-on-surface-variant leading-relaxed">
                Feel the key travel, the resistance, and the landing.
              </p>
            </div>
            <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
              <span class="material-symbols-outlined text-brand-red mb-3">music_note</span>
              <h3 class="font-bold text-on-surface mb-2">Rhythmic</h3>
              <p class="text-sm text-on-surface-variant leading-relaxed">
                Let sound and repetition carry you into a calm flow.
              </p>
            </div>
            <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
              <span class="material-symbols-outlined text-brand-red mb-3">view_quilt</span>
              <h3 class="font-bold text-on-surface mb-2">Private</h3>
              <p class="text-sm text-on-surface-variant leading-relaxed">
                Practice for yourself, not for a scoreboard.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section-card rounded-[2rem] p-8 md:p-10 lg:p-12 border border-outline-variant bg-white">
        <div class="max-w-3xl mb-8">
          <div class="inline-flex items-center gap-2 text-primary font-semibold mb-4">
            <span class="material-symbols-outlined">construction</span>
            <span>Why we built this</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-on-surface mb-4">
            Less like a gym. More like a sanctuary.
          </h2>
          <p class="text-on-surface-variant text-lg leading-relaxed">
            I started Typpy because I realized I spend so much of my day at a desk, yet I rarely pause to enjoy
            the act of creating. As a developer and a maker, I wanted a place where typing felt human again.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          {principles.map((principle, index) => (
            <article class="principle-card rounded-[1.5rem] p-6 md:p-7">
              <div class="text-xs uppercase tracking-[0.24em] text-brand-red font-bold mb-3">
                0{index + 1}
              </div>
              <h3 class="text-xl font-bold text-on-surface mb-3">{principle.title}</h3>
              <p class="text-on-surface-variant leading-relaxed">{principle.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="maker-note rounded-[2rem] p-8 md:p-10 lg:p-12 overflow-hidden relative">
        <div class="absolute -right-6 -top-6 w-40 h-40 rounded-full bg-white/20 blur-2xl"></div>
        <div class="absolute -left-10 bottom-0 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>
        <div class="relative z-10 max-w-4xl">
          <div class="inline-flex items-center gap-2 text-white font-semibold mb-4">
            <span class="material-symbols-outlined">ink_pen</span>
            <span>A note from the maker</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mb-5">
            Built for people who love the craft.
          </h2>
          <p class="text-white/90 text-lg leading-relaxed mb-5">
            I build things for people who love the craft of the digital world — {audience.join(', ')}.
            Typpy is my gift to anyone who finds peace in the click of a key.
          </p>
          <p class="text-white/90 text-lg leading-relaxed mb-8">
            Whether you&apos;re here for five minutes of zen between meetings or an hour of getting lost in the
            letters, I hope you find exactly what you&apos;re looking for.
          </p>

          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="text-white font-bold text-xl">Happy Typing,</p>
              <p class="text-white/80 italic">The Typpy Team</p>
            </div>

            <div class="rounded-[1.25rem] border border-white/30 bg-white/10 backdrop-blur px-5 py-4 max-w-md">
              <p class="text-xs uppercase tracking-[0.22em] text-white/70 mb-2">Coming soon</p>
              <p class="text-white/90 leading-relaxed">
                We&apos;re exploring calmer features like a <span class="font-semibold">Zen Mode</span> that hides
                stats until the end, so the moment stays peaceful while you type.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
  }

  .mono {
    font-family: 'JetBrains Mono', 'JetBrains+Mono', monospace;
  }

  .typing-cursor {
    display: inline-block;
    width: 10px;
    height: 20px;
    background-color: #e60023;
    margin-left: 6px;
    border-radius: 2px;
    animation: blink 1s infinite;
  }

  .hero-panel {
    background:
      radial-gradient(circle at top right, rgba(230, 0, 35, 0.12), transparent 28%),
      linear-gradient(135deg, #fff8f7 0%, #fff0ef 100%);
  }

  .hero-side {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.88) 100%),
      linear-gradient(160deg, rgba(230, 0, 35, 0.08) 0%, rgba(183, 0, 26, 0.02) 100%);
  }

  .mini-card,
  .section-card,
  .principle-card,
  .quote-card {
    box-shadow: 0 10px 30px -24px rgba(42, 22, 21, 0.24);
  }

  .quote-card {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(232, 188, 184, 0.9);
    backdrop-filter: blur(10px);
  }

  .principle-card {
    background: linear-gradient(180deg, #fff8f7 0%, #ffffff 100%);
    border: 1px solid #e8bcb8;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .principle-card:hover,
  .section-card:hover {
    transform: translateY(-2px);
    border-color: #e60023;
    box-shadow: 0 18px 40px -30px rgba(183, 0, 26, 0.5);
  }

  .section-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .maker-note {
    background:
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.25), transparent 24%),
      linear-gradient(135deg, #b7001a 0%, #e60023 55%, #ff5c75 140%);
  }

  @keyframes blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
