---
import Layout from '@/layouts/Layout.astro';

const title = 'Contact — Typpy';
const description = 'Contact Typpy for bug reports, feedback, partnership requests, or press. We aim to reply within 2 business days.';
const url = 'https://typpy.online/contact';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url,
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
        { '@type': 'ListItem', position: 2, name: 'Contact', item: url }
      ]
    }
  }
];
---

<Layout title={title} description={description} url={url} schema={schema}>
  <main class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold mb-4">Contact Typpy</h1>
    <p class="text-on-surface-variant mb-6">Bugs, ideas, partnership requests, press inquiries, or a simple hello — we&apos;d love to hear from you. You can email us directly at <a class="font-semibold underline" href="mailto:sooonism@gmail.com">sooonism@gmail.com</a>, or use the quick contact form below.</p>

    <section class="rounded-lg border border-outline-variant bg-white p-6">
      <form id="contact-form" class="space-y-4" on:submit preventDefault>
        <div>
          <label for="c-name" class="block text-sm font-medium">Your name</label>
          <input id="c-name" name="name" required class="mt-1 block w-full rounded-md border px-3 py-2" />
        </div>

        <div>
          <label for="c-email" class="block text-sm font-medium">Your email</label>
          <input id="c-email" name="email" type="email" required class="mt-1 block w-full rounded-md border px-3 py-2" />
        </div>

        <div style="display:none" aria-hidden="true">
          <label>Website (leave blank)</label>
          <input name="website" />
        </div>

        <div>
          <label for="c-subject" class="block text-sm font-medium">Subject</label>
          <input id="c-subject" name="subject" class="mt-1 block w-full rounded-md border px-3 py-2" placeholder="Bug report / Idea / Partnership" />
        </div>

        <div>
          <label for="c-message" class="block text-sm font-medium">Message</label>
          <textarea id="c-message" name="message" rows="6" required class="mt-1 block w-full rounded-md border px-3 py-2"></textarea>
        </div>

        <div>
          <button id="contact-submit" type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-red text-white font-bold">Send message</button>
          <span id="contact-status" class="ml-4 text-sm"></span>
        </div>

        <p class="text-xs text-on-surface-variant mt-3">Privacy: Submitting this form opens your email client with a pre-filled message and does not send data to our servers. See our <a class="underline" href="/privacy">Privacy Policy</a> for details.</p>
      </form>
    </section>

    <div class="mt-8 text-sm text-on-surface-variant">
      <p>If you prefer not to use the form, email: <a class="font-semibold underline" href="mailto:sooonism@gmail.com">sooonism@gmail.com</a></p>
      <p class="mt-2">For formal correspondence: Sooonism Interactive Technology, A-11-3 Mentari Condo, Jalan Sri Permaisuri 3, Bandar Tun Razak, 56000 Cheras, Kuala Lumpur, Malaysia.</p>
    </div>
  </main>

  <script is:inline>
    (function(){
      const form = document.getElementById('contact-form');
      const status = document.getElementById('contact-status');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const website = (data.get('website') || '').trim();
        if (website) { status.textContent = 'Spam detected'; return; }
        const name = (data.get('name') || '').trim();
        const email = (data.get('email') || '').trim();
        const subject = (data.get('subject') || '').trim() || 'Message from Typpy contact form';
        const message = (data.get('message') || '').trim();
        if (!name || !email || !message) { status.textContent = 'Please fill required fields'; return; }
        // Compose mailto link to open user email client (no server required)
        const body = encodeURIComponent(`${message}\n\n---\nName: ${name}\nEmail: ${email}`);
        const mailto = `mailto:sooonism@gmail.com?subject=${encodeURIComponent(subject)}&body=${body}`;
        status.textContent = 'Opening email client…';
        // open mailto
        window.location.href = mailto;
        setTimeout(()=>{ status.textContent = 'If your email client did not open, please email soonism@gmail.com directly.'; }, 1500);
      });
    })();
  </script>
</Layout>
