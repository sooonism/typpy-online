---
import Layout from '@/layouts/Layout.astro';
import TypespaceGame from '@/components/svelte/games/typespace.svelte';

const title = 'TypeSpace — Typpy';
const description = 'TypeSpace: a focused quote typing challenge for building speed, rhythm, and accuracy.';
const url = 'https://typpy.online/games/typespace';
const image = 'https://typpy.online/og/default.png';
const keywords = 'typespace, typing, quote typing, focus, speed, accuracy, typing game';
const genre = 'Educational';
const releaseDate = '2026-05-11';
const developer = 'Typpy';
const publisher = 'Typpy';
const platform = 'Web';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title,
    description,
    url,
    image,
    brand: { '@type': 'Brand', name: 'Typpy', description: 'Typpy — happy typing' },
    applicationCategory: 'Educational Typing Game',
    operatingSystem: 'Web',
    author: { '@type': 'Organization', name: 'Typpy' },
    publisher: { '@type': 'Organization', name: 'Typpy' },
    genre,
    datePublished: releaseDate
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
      { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://typpy.online/games' },
      { '@type': 'ListItem', position: 3, name: 'TypeSpace', item: url }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image={image} keywords={keywords} genre={genre} releaseDate={releaseDate} developer={developer} publisher={publisher} platform={platform} schema={schema}>
  <main class="max-w-5xl mx-auto px-6 py-8">
    <h1 class="text-3xl font-bold mb-2">TypeSpace</h1>
    <p class="text-on-surface-variant mb-6">Type through short quotes in a clean, focused layout designed to sharpen rhythm, accuracy, and sustained typing flow.</p>
  </main>
  <TypespaceGame client:only="svelte" />
</Layout>