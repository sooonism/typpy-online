---
import Layout from '@/layouts/Layout.astro';
import ScrambletypeGame from '@/components/react/scrambletype.jsx';

const title = 'ScrambleType — Typpy';
const description = 'ScrambleType: unscramble words one letter at a time to train spelling, focus, and typing precision.';
const url = 'https://typpy.online/games/scrambletype/';
const image = 'https://typpy.online/og/default.png';
const keywords = 'scrambletype, typing, word scramble, spelling, focus, typing game';
const genre = 'Puzzle';
const releaseDate = '2026-05-11';
const developer = 'Typpy';
const publisher = 'Typpy';
const platform = 'Web';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title,
    description,
    url,
    image,
    brand: { '@type': 'Brand', name: 'Typpy', description: 'Typpy — happy typing' },
    applicationCategory: 'Puzzle Typing Game',
    operatingSystem: 'Web',
    author: { '@type': 'Organization', name: 'Typpy' },
    publisher: { '@type': 'Organization', name: 'Typpy' },
    genre,
    datePublished: releaseDate
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
      { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://typpy.online/games/' },
      { '@type': 'ListItem', position: 3, name: 'ScrambleType', item: url }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image={image} keywords={keywords} genre={genre} releaseDate={releaseDate} developer={developer} publisher={publisher} platform={platform} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-10 md:py-14">
    <div class="max-w-5xl mx-auto">
      <section class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)]">
        <div class="p-8 md:p-12 lg:p-14">
          <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
            <span class="material-symbols-outlined text-[18px]">shuffle</span>
            {genre}
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-on-surface mb-5 leading-[0.95]">ScrambleType</h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl leading-relaxed">Unscramble each word one letter at a time. Build spelling accuracy, reaction speed, and keyboard control under pressure.</p>
        </div>
      </section>
    </div>
  </main>
  <ScrambletypeGame client:only="react" />
</Layout>