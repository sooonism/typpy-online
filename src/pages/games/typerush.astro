---
import Layout from '@/layouts/Layout.astro';
import TyperushGame from '@/components/svelte/games/typerush.svelte';

const title = 'Type Rush — Typpy';
const description = 'Type Rush: a fast arcade typing challenge with collectible diamonds. Typpy — happy typing.';
const url = 'https://typpy.online/games/typerush';
const image = 'https://typpy.online/games/typerush.png';
const keywords = 'type, rush, typing, arcade, speed, diamonds, typing game, brain training';
const genre = 'Arcade';
const releaseDate = '2026-04-27';
const developer = 'Typpy';
const publisher = 'Typpy';
const platform = 'Web';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": title,
    "description": description,
    "url": url,
    "image": image,
    "brand": { "@type": "Brand", "name": "Typpy", "description": "Typpy — happy typing" },
    "applicationCategory": "Arcade Typing Game",
    "operatingSystem": "Web",
    "author": { "@type": "Organization", "name": "Typpy" },
    "publisher": { "@type": "Organization", "name": "Typpy" },
    "genre": genre,
    "datePublished": releaseDate
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://typpy.online" },
      { "@type": "ListItem", "position": 2, "name": "Games", "item": "https://typpy.online/games" },
      { "@type": "ListItem", "position": 3, "name": "Type Rush", "item": "https://typpy.online/games/typerush" }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image={image} keywords={keywords} genre={genre} releaseDate={releaseDate} developer={developer} publisher={publisher} platform={platform} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-10 md:py-14">
    <div class="max-w-5xl mx-auto space-y-10 md:space-y-14">
      <section class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)]">
        <div class="p-8 md:p-12 lg:p-14">
          <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
            <span class="material-symbols-outlined text-[18px]">bolt</span>
            {genre}
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-on-surface mb-5 leading-[0.95]">Type Rush</h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl leading-relaxed">Race against the clock in a fast typing arcade challenge. Improve speed, rhythm, and accuracy with real-time feedback.</p>
        </div>
      </section>

      <section id="how-to-play" class="space-y-5 md:space-y-7">
        <div class="inline-flex items-center gap-3 text-primary font-semibold">
          <span class="material-symbols-outlined text-[26px]">play_lesson</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight text-on-surface">How to play</h2>
        </div>

        <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-surface-container-low">
          <p class="text-lg text-on-surface leading-relaxed">Type Rush is a 60‑second arcade round where words appear and you type them to collect diamonds and score points. It rewards accuracy and rhythm as much as raw speed.</p>
        </article>

        <div class="grid md:grid-cols-2 gap-5 md:gap-6">
          <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-white transition duration-200 hover:-translate-y-0.5 hover:border-brand-red hover:shadow-[0_18px_40px_-30px_rgba(183,0,26,0.5)]">
            <h3 class="flex items-center gap-2 text-xl font-bold text-on-surface mb-4">
              <span class="material-symbols-outlined text-brand-red text-[22px]">track_changes</span>
              Objective
            </h3>
            <ul class="list-disc ml-5 space-y-2 text-on-surface-variant leading-relaxed">
              <li>Type as many words correctly as you can within the time limit.</li>
              <li>Collect diamonds to earn bonus points (+500 points per diamond).</li>
              <li>Maintain accuracy to preserve score multipliers and streak bonuses.</li>
            </ul>
          </article>

          <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-white transition duration-200 hover:-translate-y-0.5 hover:border-brand-red hover:shadow-[0_18px_40px_-30px_rgba(183,0,26,0.5)]">
            <h3 class="flex items-center gap-2 text-xl font-bold text-on-surface mb-4">
              <span class="material-symbols-outlined text-brand-red text-[22px]">keyboard</span>
              Controls
            </h3>
            <ul class="list-disc ml-5 space-y-2 text-on-surface-variant leading-relaxed">
              <li>Start a round by clicking Play or pressing Enter.</li>
              <li>Type the displayed words into the active input; use Backspace to correct mistakes.</li>
              <li>Press Space or Enter if the mode requires submission — otherwise typing will advance automatically.</li>
            </ul>
          </article>

          <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-white transition duration-200 hover:-translate-y-0.5 hover:border-brand-red hover:shadow-[0_18px_40px_-30px_rgba(183,0,26,0.5)]">
            <h3 class="flex items-center gap-2 text-xl font-bold text-on-surface mb-4">
              <span class="material-symbols-outlined text-brand-red text-[22px]">scoreboard</span>
              Scoring
            </h3>
            <p class="text-on-surface-variant leading-relaxed">Each correctly typed word gives base points. Diamonds grant a fixed bonus (+500). Sustained accuracy and streaks increase overall score — prioritise accuracy over wild speed for best results.</p>
          </article>

          <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-white transition duration-200 hover:-translate-y-0.5 hover:border-brand-red hover:shadow-[0_18px_40px_-30px_rgba(183,0,26,0.5)]">
            <h3 class="flex items-center gap-2 text-xl font-bold text-on-surface mb-4">
              <span class="material-symbols-outlined text-brand-red text-[22px]">lightbulb</span>
              Tips
            </h3>
            <ul class="list-disc ml-5 space-y-2 text-on-surface-variant leading-relaxed">
              <li>Warm up in Practice mode to build rhythm without the timer.</li>
              <li>Focus on accuracy first; higher accuracy yields better final scores than many fast mistakes.</li>
              <li>Use a physical keyboard and disable browser extensions that alter typing input.</li>
              <li>Listen to the sound feedback — the rhythm helps many players maintain flow.</li>
            </ul>
          </article>
        </div>

        <article class="rounded-[2rem] p-6 md:p-8 border border-outline-variant bg-surface-container-low">
          <h3 class="flex items-center gap-2 text-xl font-bold text-on-surface mb-4">
            <span class="material-symbols-outlined text-brand-red text-[22px]">build</span>
            Troubleshooting
          </h3>
          <p class="text-on-surface-variant leading-relaxed">If the game feels laggy: try a different browser (Chrome/Edge recommended), close heavy tabs, or test in incognito mode to rule out extensions. On mobile, landscape + an external keyboard gives the best experience.</p>
          <p class="mt-4 text-sm text-on-surface-variant">Scores are stored locally by default. To request a feature or report a bug, please visit the <a href="/contact" class="underline">Contact</a> page.</p>
        </article>
      </section>
    </div>
  </main>

  <TyperushGame client:only="svelte" />
</Layout>
