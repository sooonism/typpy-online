---
import Layout from '@/layouts/Layout.astro';
import ZentypeGame from '@/components/svelte/games/zentype.svelte';

const title = 'Zen Typing Test — Calm, Untimed Typing Practice — Typpy';
const description = 'A zen typing test with no timer and no leaderboard. Type a short passage at your own pace, then see your WPM and accuracy. Free, in your browser.';
const url = 'https://typpy.online/games/zentype/';
const image = 'https://typpy.online/games/zentype.png';
const keywords = 'zen typing test, zen typing, relaxing typing game, calm typing practice, no timer typing, typing zen';
const genre = 'Educational';
const releaseDate = '2026-04-26';
const developer = 'Typpy';
const publisher = 'Typpy';
const platform = 'Web';

const faq = [
  ['What is a zen typing test?', 'A zen typing test is typing practice without a countdown or a race. You type a passage at your own pace and see your speed (WPM) and accuracy only when you finish.'],
  ['Is ZenType timed?', 'No. There is no timer. The clock starts when you type your first character and the result appears when you finish the text.'],
  ['Does ZenType measure WPM and accuracy?', 'Yes. You see words per minute and accuracy live while you type, and a summary at the end.'],
  ['Is it free, and do I need an account?', 'It is free and runs in your browser. No account or download is needed.'],
  ['How do I try again?', 'Use the restart button next to the text to get a fresh passage.']
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(([q, a]) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": title.split(" — ")[0],
    "description": description,
    "url": url,
    "image": image,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "applicationCategory": "Typing Game",
    "operatingSystem": "Web",
    "author": { "@type": "Organization", "name": "Typpy" },
    "publisher": { "@type": "Organization", "name": "Typpy" },
    "genre": "Educational",
    "datePublished": releaseDate
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://typpy.online" },
      { "@type": "ListItem", "position": 2, "name": "Games", "item": "https://typpy.online/games/" },
      { "@type": "ListItem", "position": 3, "name": "ZenType", "item": "https://typpy.online/games/zentype" }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image={image} keywords={keywords} genre={genre} releaseDate={releaseDate} developer={developer} publisher={publisher} platform={platform} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-10 md:py-14">
    <div class="max-w-5xl mx-auto">
      <section class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)]">
        <div class="p-8 md:p-12 lg:p-14">
          <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
            <span class="material-symbols-outlined text-[18px]">self_improvement</span>
            {genre}
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-on-surface mb-5 leading-[0.95]">ZenType</h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl leading-relaxed">A zen typing test: no timer, no leaderboard, just you and the text. Type at your own pace, then see your WPM and accuracy when you finish.</p>
        </div>
      </section>
      <section class="mt-10">
        <h2 class="text-2xl font-black tracking-tight text-on-surface mb-4">Zen typing test: questions</h2>
        <dl class="space-y-4">
          {faq.map(([q, a]) => (
            <div>
              <dt class="font-bold text-on-surface">{q}</dt>
              <dd class="text-on-surface-variant leading-relaxed">{a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </main>
  <ZentypeGame client:only="svelte" />
</Layout>
