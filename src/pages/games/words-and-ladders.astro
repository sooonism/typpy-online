---
const title = 'Words and Ladders — Word Chain Typing Game — Typpy';
const description = 'Words and Ladders: a calm word game on a snakes-and-ladders board. Type words along the path, chain them by their last letter, and climb to the crown. Free, no signup.';
const keywords = 'word ladder game, word chain game, snakes and ladders word game, calm typing game, relaxing word game';
const url = 'https://typpy.online/games/words-and-ladders/';
const image = 'https://typpy.online/og/default.png';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Words and Ladders',
    description,
    url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    applicationCategory: 'Casual Word Game',
    operatingSystem: 'Web',
    author: { '@type': 'Organization', name: 'Typpy' },
    publisher: { '@type': 'Organization', name: 'Typpy' },
    genre: 'Puzzle',
    datePublished: '2026-11-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
      { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://typpy.online/games/' },
      { '@type': 'ListItem', position: 3, name: 'Words and Ladders', item: url }
    ]
  }
];
---
<!doctype html>
