<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    min-height:100vh;padding:56px 16px 24px;background:#efe7da;
    background:radial-gradient(circle at top,#faf6ef,#efe7da 60%,#e6dbcb);
    color:#4a3f31;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    display:flex;flex-direction:column;align-items:center;gap:12px;
  }
  .back-link{
    position:fixed;top:14px;left:14px;z-index:10;
    font:500 12px system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    color:#8a7a66;text-decoration:none;letter-spacing:.04em;
    padding:6px 10px;border-radius:999px;opacity:.6;transition:opacity .2s;
  }
  .back-link:hover{opacity:1}
  html.framed .back-link{display:none}
  h1{margin:0;font-size:clamp(22px,4vw,32px);font-weight:700;color:#4a3f31}
  .sub{margin:0;color:#8a7a66;max-width:840px;text-align:center;font-size:14px;line-height:1.55}
  .sub strong{color:#4a3f31}
  .game{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;align-items:flex-start;width:100%;max-width:1080px}
  canvas{
    width:min(92vw,592px);height:auto;display:block;background:#faf6ef;
    border:1px solid #e0d5c3;border-radius:16px;box-shadow:0 12px 40px rgba(110,90,60,.15);
  }
  .panel{
    width:min(92vw,360px);background:#faf6ef;border:1px solid #e0d5c3;
    border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:10px;
  }
  .status{padding:10px 12px;border-radius:10px;background:#f3ecdf;border:1px solid #e0d5c3;color:#6d5f4e;line-height:1.45;font-size:14px;min-height:60px}
  .status.good{color:#3f5f3a;border-color:#b7c9a8;background:#e8efdc}
  .status.bad{color:#8a2f1f;border-color:#e0b4a6;background:#f6e2da}
  .status.warn{color:#7a5a1c;border-color:#e3cf9f;background:#f6edd3}
  .status.win{color:#3f5f3a;border-color:#9cb88a;background:#e8efdc;font-weight:600}
  .req-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .req-box{padding:10px 12px;background:#f3ecdf;border:1px solid #e0d5c3;border-radius:10px;display:flex;flex-direction:column;gap:2px}
  .req-box .label{color:#8a7a66;font-size:11px;text-transform:uppercase;letter-spacing:.5px}
  .req-box .letter{font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:800;font-size:26px;color:rgb(206,106,58);line-height:1}
  .req-box .letter.min{color:#a8761c}
  .row{display:flex;gap:8px}
  @keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-7px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}
  input.shake{animation:shake .35s;border-color:#c0583a}
  input{flex:1;min-width:0;padding:11px 12px;border-radius:10px;border:1px solid #d6c9b4;background:#fff;color:#4a3f31;font-size:16px;outline:none}
  input:focus{border-color:rgb(206,106,58);box-shadow:0 0 0 3px rgba(206,106,58,.18)}
  input:disabled{opacity:.5}
  button{padding:11px 14px;border-radius:10px;border:1px solid rgb(206,106,58);background:rgb(206,106,58);color:#fff;font-weight:700;cursor:pointer;font-size:14px}
  button:hover{background:rgb(184,90,45)}
  button:disabled{opacity:.5;cursor:not-allowed}
  button.secondary{background:#f3ecdf;border-color:#d6c9b4;color:#6d5f4e}
  button.secondary:hover{background:#ebe1d0}
  .icon-btn{padding:11px 10px;min-width:44px}
  .progress{width:100%;height:8px;background:#e6dbcb;border-radius:99px;overflow:hidden}
  .progress>div{height:100%;background:linear-gradient(90deg,#8fa86f,rgb(206,106,58));width:0%;transition:width .3s}
  .progress-wrap{display:flex;flex-direction:column;gap:4px;font-size:12px;color:#8a7a66}
  .legend{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;color:#8a7a66}
  .dot{display:inline-block;width:10px;height:10px;border-radius:99px;margin-right:5px;vertical-align:middle}
  .debug{font-size:12px;color:#8a7a66;border-top:1px solid #e0d5c3;padding-top:8px;line-height:1.6;font-family:ui-monospace,Menlo,monospace}
  .debug b{color:#4a3f31;font-weight:600}
  .board-wrap{display:contents}
  #rulesBtn,#miniBtn{display:none}
  dialog{border:1px solid #e0d5c3;border-radius:16px;background:#faf6ef;color:#4a3f31;padding:20px;max-width:min(92vw,420px)}
  dialog::backdrop{background:rgba(74,63,49,.45)}
  dialog p{margin:0 0 14px;font-size:14px;line-height:1.55;color:#6d5f4e;text-align:left}
  dialog strong{color:#4a3f31}

  /* Mobile: board plus a one-line status and one input row. The layout is pinned to the
     visual viewport (see fit() below) so the soft keyboard never covers the input. */
  @media (max-width:700px){
    html,body{overflow:hidden}
    body{position:fixed;left:0;right:0;top:0;height:var(--vh,100dvh);min-height:0;padding:34px 8px 8px;gap:6px}
    h1,.sub,.req-grid,.progress-wrap,.legend,.debug{display:none}
    .back-link{top:6px;left:8px;opacity:.8}
    #rulesBtn{display:block;position:fixed;top:4px;right:8px;z-index:10;padding:4px 12px;border-radius:999px;font-size:14px}
    .game{flex:1;min-height:0;flex-direction:column;flex-wrap:nowrap;gap:6px;width:100%;max-width:none;justify-content:flex-start}
    .board-wrap{display:block;position:relative;flex:1;min-height:0;width:100%}
    canvas{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:none;box-shadow:none}
    .panel{width:100%;padding:8px;gap:6px;border-radius:12px}
    .status{padding:6px 10px;min-height:0;font-size:13px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .row button{padding:10px 12px}
    .panel{position:relative}
    #miniBtn{display:flex;align-items:center;justify-content:center;position:absolute;top:-13px;right:12px;z-index:2;width:30px;height:26px;padding:0;border-radius:999px;font-size:13px;line-height:1;background:#faf6ef;border:1px solid #d6c9b4;color:#8a7a66}
    #miniBtn:hover{background:#f3ecdf}
    .panel.mini .status,.panel.mini .tools{display:none}
    .row .secondary{flex:1}
    .row .icon-btn{flex:0 0 auto}
  }
</style>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-FKXKL01WVD"></script>
