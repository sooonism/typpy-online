---
const title = 'Tidy — A Calm, No-Rush Typing Game — Typpy';
const description = 'Tidy: a calm, no-rush typing game. Clear a cluttered room one word at a time and feel the satisfaction build as it empties.';
const keywords = 'tidy, calm typing game, zen typing game, relaxing typing practice, no pressure typing, declutter game, typing game online';
const url = 'https://typpy.online/games/tidy/';
const image = 'https://typpy.online/og/default.png';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title.split(" — ")[0],
    description,
    url,
    brand: { '@type': 'Brand', name: 'Typpy', description: 'Typpy — happy typing' },
    applicationCategory: 'Casual Typing Game',
    operatingSystem: 'Web',
    author: { '@type': 'Organization', name: 'Typpy' },
    publisher: { '@type': 'Organization', name: 'Typpy' },
    genre: 'Casual',
    datePublished: '2026-10-18'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
      { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://typpy.online/games/' },
      { '@type': 'ListItem', position: 3, name: 'Tidy', item: url }
    ]
  }
];
---
