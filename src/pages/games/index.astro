---
import GameTitleTile from '@/components/GameTitleTile.astro';
import Layout from '@/layouts/Layout.astro';
import { games } from '@/data/games';

const title = 'Relaxing Typing Games, No Timer — Typpy';
const description = 'Cozy typing games with no countdown, led by Tidy, plus a few arcade ones against the clock. Each game is labeled so you can pick your mood. Free in your browser.';

// no countdown (Tidy has no clock at all; the others count up for stats only)
const calm = new Set(['tidy', 'tidy-es', 'tidy-ja', 'tidy-ms', 'zentype', 'zentype-reverse', 'typespace']);
const sorted = [...games].sort((a, b) => Number(calm.has(b.slug)) - Number(calm.has(a.slug)));
const url = 'https://typpy.online/games/';

// games list is provided by /src/data/games.ts

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: games.map((game, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: game.title,
        url: `https://typpy.online${game.href.replace(/\/?$/, "/")}`
      }))
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
      { '@type': 'ListItem', position: 2, name: 'Games', item: url }
    ]
  }
];
---

<Layout title={title} description={description} url={url} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-10 md:py-16">
    <div class="max-w-5xl mx-auto space-y-10 md:space-y-14">
      <section class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)]">
        <div class="p-8 md:p-12 lg:p-14">
          <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
            <span class="material-symbols-outlined text-[18px]">sports_esports</span>
            Games
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-on-surface mb-5 leading-[0.95]">Relaxing typing games</h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl leading-relaxed mb-7">Calm typing games with no countdown, led by <a href="/games/tidy" class="underline hover:text-primary">Tidy</a>. A few arcade games with a clock are here too, and every game is labeled so you can pick your mood.</p>
          <div class="flex flex-wrap gap-4 items-center">
            <button
              id="random-game-btn"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-red text-white font-bold shadow-md hover:-translate-y-0.5 transition-transform"
            >
              <span class="material-symbols-outlined text-[18px]">shuffle</span>
              Play Random Game
            </button>
            <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-on-surface-variant hover:text-primary transition-colors">
              <span class="material-symbols-outlined text-[16px]">arrow_back</span>
              Back to home
            </a>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {sorted.map(game => (
          <a href={game.href} class="block rounded-2xl border border-outline-variant overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition duration-200 group bg-white">
            {game.image ? (
              <img src={game.image} alt={game.title} class="w-full h-40 object-cover" />
            ) : (
              <GameTitleTile title={game.title} subtitle="" badgeText="" compact={true} />
            )}
            <div class="p-4 bg-surface">
              <span class="inline-block mb-2 px-2 py-0.5 rounded-full border border-outline-variant text-[11px] uppercase tracking-[0.15em] text-on-surface-variant">{calm.has(game.slug) ? 'No countdown' : 'Against the clock'}</span>
              <h2 class="text-xl font-semibold group-hover:text-primary transition-colors">{game.title}</h2>
              <p class="text-sm text-on-surface-variant mt-2">{game.description}</p>
              <div class="mt-4">
                <span class="inline-block px-4 py-2 bg-primary text-white rounded-full text-sm font-semibold group-hover:bg-brand-red transition-colors">Play</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <section class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 md:p-8">
        <h2 class="text-xl font-bold mb-2">Learning a language? Pair Tidy with Duolingo.</h2>
        <p class="text-on-surface-variant leading-relaxed">Duolingo gives you structure and a push. Tidy is the opposite: no streaks, no hearts, no clock, just the words that won't stick. They work well together. <a class="underline hover:text-primary" href="/blog/Duolingo_and_Tidy_20261021">Read why</a>.</p>
      </section>
    </div>
  </main>

  <script define:vars={{ GAMES: games }}>
    document.getElementById('random-game-btn')?.addEventListener('click', () => {
      if (!GAMES || !GAMES.length) { location.href = '/games'; return; }
      const idx = Math.floor(Math.random() * GAMES.length);
      location.href = GAMES[idx].href || '/games';
    });
  </script>
</Layout>
