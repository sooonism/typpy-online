---
import Layout from '@/layouts/Layout.astro';
import TypefallGame from '@/components/svelte/games/typefall.svelte';

const title = 'TypeFall — Typpy';
const description = 'TypeFall: falling words typing game to sharpen reflexes and accuracy.';
const url = 'https://typpy.online/games/typefall';
const image = 'https://typpy.online/games/typefall.png';
const keywords = 'typing, arcade, reflex, speed, accuracy, typing game';
const genre = 'Arcade';
const releaseDate = '2026-04-26';
const developer = 'Typpy';
const publisher = 'Typpy';
const platform = 'Web';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": title,
    "description": description,
    "url": url,
    "image": image,
    "brand": { "@type": "Brand", "name": "Typpy", "description": "Typpy — happy typing" },
    "applicationCategory": "Arcade Typing Game",
    "operatingSystem": "Web",
    "author": { "@type": "Organization", "name": "Typpy" },
    "publisher": { "@type": "Organization", "name": "Typpy" },
    "genre": "Arcade",
    "datePublished": releaseDate
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://typpy.online" },
      { "@type": "ListItem", "position": 2, "name": "Games", "item": "https://typpy.online/games" },
      { "@type": "ListItem", "position": 3, "name": "TypeFall", "item": "https://typpy.online/games/typefall" }
    ]
  }
];
---

<Layout title={title} description={description} url={url} image={image} keywords={keywords} genre={genre} releaseDate={releaseDate} developer={developer} publisher={publisher} platform={platform} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-10 md:py-14">
    <div class="max-w-5xl mx-auto">
      <section class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)]">
        <div class="p-8 md:p-12 lg:p-14">
          <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
            <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
            {genre}
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-on-surface mb-5 leading-[0.95]">TypeFall</h1>
          <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl leading-relaxed">Catch falling words before they hit the bottom. Train reflexes, spelling precision, and typing consistency under pressure.</p>
        </div>
      </section>
    </div>
  </main>
  <TypefallGame client:only="svelte" />
</Layout>
