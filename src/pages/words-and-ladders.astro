---
import Layout from '@/layouts/Layout.astro';

const title = 'Words and Ladders: A Snakes-and-Ladders Word Game — Typpy';
const description = 'Words and Ladders is a free word-chain game on a snakes-and-ladders board: type real words, carry the last letter forward, ride the links to the crown. No timer, no sign-up.';
const url = 'https://typpy.online/words-and-ladders/';
const keywords = 'word ladder game, word chain game, snakes and ladders word game, last letter word game, word board game online, calm word game';

const steps = [
  'The board is 10 by 10 cells, and your piece starts in the bottom-left corner. The path snakes left to right, then right to left, up to the crown in the top-left.',
  'Each round rolls a minimum word length from 2 to 6 letters, and 6 is the most likely roll. The cells that length would cover are outlined in orange, and the first one, where your word starts, pulses.',
  'Type a real English word at least that long. Its letters fill the path one at a time. Longer words are allowed, and they move you further.',
  'When the word ends, only its last letter stays on the board. Your next word has to start with that letter, and the game fills it into the input for you.',
  'The board has 7 to 10 random pairs of linked cells. If the last letter of your word lands on a linked cell, you jump to its partner, which can be up or down the board. Passing through a link in the middle of a word does nothing.',
  'To win, your last letter has to land exactly on the crown, so the final word must be exactly as long as the cells you have left.'
];

const tips = [
  ['Plan the last letter, not the first', 'Only the last letter carries over, so a word ending in S, E, D, T, R or N leaves you easy words to follow it with. A word ending in Q or X can leave you stuck.'],
  ['Read the links before you type', 'Count along the snake path to the end of your word. If it lands on a link that sends you forward, a word of that exact length is worth more than a longer one.'],
  ['Longer words cover more ground', 'The minimum is only a floor. A 9-letter word moves you 9 cells, so long words are how you catch up when a bad roll or a downward link sets you back.'],
  ['Count the cells before the crown', 'When only a few cells are left the minimum shrinks to fit, and the final word has to match the remaining cells exactly. The Hint button suggests one that does.']
];

const faqs = [
  ['What is Words and Ladders?', 'Words and Ladders is a free word game played on a 10 by 10 snakes-and-ladders board. You type real English words, the letters fill the board along a snake path, and you win by reaching the crown.'],
  ['How do the rules work?', 'Each round rolls a minimum word length from 2 to 6. Type a word at least that long and it fills the path. Only its last letter stays on the board, and your next word must start with that letter.'],
  ['What are the links?', 'Each game has 7 to 10 random pairs of linked cells. If the last letter of your word lands on a linked cell, you jump to the partner cell, which can send you up or down the board. Links are random each game.'],
  ['Does it check that my word is real?', 'Yes. Words are checked against an English dictionary, and common plurals and verb endings such as -s, -ed and -ing are accepted. A word that is not accepted shakes the input so you can try again.'],
  ['Is there a timer or a score?', 'No. There is no clock, no score and no lives. The game ends when you reach the crown, and you can reset for a new board with new links at any time.'],
  ['How do I win?', 'Land the last letter of a word exactly on the crown in the top-left corner. Near the end the final word must be exactly as long as the cells that remain.'],
  ['Does it work on a phone?', 'Yes. On mobile the board fills the screen, the rules open in a popup, and the controls can be minimised so the keyboard does not cover the input.'],
  ['Is it free?', 'Yes. There is no sign-up and no account. Typpy is supported by ads.']
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title.split(' — ')[0],
    description,
    url,
    inLanguage: 'en'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to play Words and Ladders',
    step: steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
  }
];
---

<Layout title={title} description={description} url={url} keywords={keywords} schema={schema}>
  <main class="flex-grow w-full px-6 md:px-12 py-section">
    <div class="max-w-3xl mx-auto pt-16 md:pt-24 space-y-12">
      <header>
        <p class="text-sm uppercase tracking-[0.28em] text-on-surface-variant mb-4">A word chain on a game board</p>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight text-on-surface mb-6 leading-[1]">
          Words and Ladders, a word game <span class="text-brand-red italic">with no timer</span>
        </h1>
        <p class="text-lg text-on-surface font-semibold leading-relaxed mb-4">
          Words and Ladders is a free word-chain game on a snakes-and-ladders board: type real words along a snake path, carry each word's last letter into the next one, and ride random links up to the crown. No clock, no score, no account.
        </p>
        <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed mb-8">
          It is part vocabulary puzzle, part board game, and it works on a phone.
        </p>
        <a href="/games/words-and-ladders/" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-red text-white font-bold shadow-md hover:-translate-y-0.5 transition-transform">
          <span class="material-symbols-outlined text-[18px]">play_arrow</span>
          Play Words and Ladders
        </a>
      </header>

      <section>
        <h2 class="text-2xl font-bold tracking-tight mb-4">How to play</h2>
        <ol class="space-y-3 text-on-surface-variant leading-relaxed list-decimal pl-6">
          {steps.map(s => <li>{s}</li>)}
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight mb-4">A sample turn</h2>
        <p class="text-on-surface-variant leading-relaxed">
          The first round is always an easy 3 or 4 letters. Say you type <strong class="text-on-surface">PLAY</strong>: P, L, A and Y fill the first four cells of the bottom row, and only the Y stays. Your next word must start with Y, and it begins on that same cell, so <strong class="text-on-surface">YARD</strong> fills the Y cell and the next three, and leaves a D. If that D sits on a linked cell, you jump to its partner and carry on from there.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight mb-4">Tips for reaching the crown</h2>
        <div class="space-y-5">
          {tips.map(([h, p]) => (
            <div>
              <h3 class="font-bold text-on-surface mb-1">{h}</h3>
              <p class="text-on-surface-variant leading-relaxed">{p}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold tracking-tight mb-4">Questions</h2>
        <div class="space-y-6">
          {faqs.map(([q, a]) => (
            <div>
              <h3 class="font-bold text-on-surface mb-1">{q}</h3>
              <p class="text-on-surface-variant leading-relaxed">{a}</p>
            </div>
          ))}
        </div>
      </section>

      <p class="text-on-surface-variant leading-relaxed">
        More calm games are in the <a class="text-brand-red font-semibold" href="/games/">games catalogue</a>, including <a class="text-brand-red font-semibold" href="/tidy/">Tidy</a>, a typing game with no timer.
      </p>
    </div>
  </main>
</Layout>
