---
import Layout from '@/layouts/Layout.astro';
import { games } from '@/data/games';

const title = 'Typpy — Happy Typing Games';
const description = 'Play fun typing games to improve speed, accuracy, and focus. Typpy helps you build real-world typing skills through playful challenges.';
const url = 'https://typpy.online/';
---

<Layout title={title} description={description} url={url}>
	<main class="flex-grow flex flex-col items-center justify-center py-section px-6 md:px-12 w-full max-w-6xl mx-auto home">
		<h1 class="text-4xl md:text-5xl font-extrabold mb-4">Typpy — Happy Typing Games</h1>
		<p class="text-lg md:text-xl text-on-surface-variant max-w-3xl text-center mb-6">Typpy helps you build real-world typing skills through playful challenges — improve speed, accuracy, and focus with bite-sized games.</p>

		<div class="mb-4 flex items-center gap-3">
			<button id="random-game-btn" class="px-6 py-3 rounded-full bg-primary text-white font-bold hover:opacity-95">Play Random Game</button>
			<a href="/games" class="ml-4 text-sm text-on-surface-variant hover:text-primary">Browse games</a>
		</div>
	</main>

	<script is:inline>
		const GAMES = {JSON.stringify(games)};
		document.getElementById('random-game-btn')?.addEventListener('click', () => {
			if (!GAMES || !GAMES.length) { location.href = '/games'; return; }
			const idx = Math.floor(Math.random() * GAMES.length);
			location.href = GAMES[idx].href || '/games';
		});
	</script>
</Layout>

<style>
	.home {
		min-height: 100vh;
		padding: 2rem 1.25rem;
		background:
			radial-gradient(circle at 20% 20%, #facc15 0%, transparent 30%),
			radial-gradient(circle at 80% 0%, #f97316 0%, transparent 40%),
			linear-gradient(160deg, #f8fafc 0%, #fff7ed 100%);
		color: #292524;
	}
</style>
