---
import Layout from '@/layouts/Layout.astro';
import { games } from '@/data/games';

const title = 'Typpy — Relaxing Typing Games, No Timer';
const description = 'Cozy typing games with no timer and no score pressure. Tidy a room of words, clear your head, and let your typing settle. Free in your browser.';
const url = 'https://typpy.online/';
const featured = games.find(g => g.slug === 'tidy');
---

<Layout title={title} description={description} url={url}>
	<main class="flex-grow w-full home">
		<!-- Hero -->
		<section class="flex flex-col items-center justify-center px-6 md:px-12 w-full max-w-6xl mx-auto py-section">
			<h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-center">Relaxing typing games, no timer</h1>
			<p class="text-lg md:text-xl text-on-surface-variant max-w-3xl text-center mb-6">Typpy is a cozy place to type. Clear your head with Tidy and other calm games with no countdown, and get faster and more accurate as a side effect.</p>

			<div class="mb-4 flex items-center gap-3">
				<a href="/games/tidy" class="px-6 py-3 rounded-full bg-primary text-white font-bold hover:opacity-95">Play Tidy — no timer</a>
				<button id="random-game-btn" class="px-6 py-3 rounded-full border border-outline-variant font-bold text-on-surface hover:opacity-95">Random game</button>
				<a href="/games" class="ml-4 text-sm text-on-surface-variant hover:text-primary">Browse games</a>
			</div>
		</section>

		<!-- Featured game -->
		<section class="px-6 md:px-12 pb-section w-full max-w-5xl mx-auto">
			<div class="rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low bg-[radial-gradient(circle_at_top_right,rgba(230,0,35,0.12),transparent_28%),linear-gradient(135deg,#fff8f7_0%,#fff0ef_100%)] p-8 md:p-12">
				<div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
					<div class="lg:w-[38%] text-center lg:text-left">
						<div class="inline-flex items-center gap-2 px-4 py-2 mb-5 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
							<span class="material-symbols-outlined text-[18px]">sports_esports</span>
							Featured game
						</div>
						<h2 class="text-4xl md:text-5xl font-black tracking-tight text-on-surface mb-4 leading-[0.95]">Tidy</h2>
						<p class="text-on-surface-variant leading-relaxed mb-6">A cluttered room of words, and nothing but your typing to clear it. No clock, no pressure — just you, the keys, and the satisfaction of watching the pile shrink to nothing.</p>
						<a href="/games/tidy" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-red text-white font-bold shadow-md hover:-translate-y-0.5 transition-transform">
							<span class="material-symbols-outlined text-[18px]">play_arrow</span>
							Play Tidy
						</a>
						<div class="flex flex-wrap gap-2 mt-3">
							<a href="/games/tidy-es" class="px-4 py-2 rounded-xl border border-outline-variant text-sm font-bold text-on-surface hover:-translate-y-0.5 transition-transform">Español</a>
							<a href="/games/tidy-ms" class="px-4 py-2 rounded-xl border border-outline-variant text-sm font-bold text-on-surface hover:-translate-y-0.5 transition-transform">Bahasa Melayu</a>
							<a href="/games/tidy-ja" class="px-4 py-2 rounded-xl border border-outline-variant text-sm font-bold text-on-surface hover:-translate-y-0.5 transition-transform">日本語</a>
						</div>
					</div>
					<div class="lg:w-[62%] w-full">
						<a href="/games/tidy" class="tidy-preview block relative w-full h-[420px] md:h-[480px] rounded-2xl border border-outline-variant overflow-hidden bg-[linear-gradient(180deg,#faf6ef_0%,#f1e9dd_60%,#e6dbcb_100%)]">
							<span class="tidy-chip" style="top:18%;left:8%;--r:-4deg;">tidy</span>
							<span class="tidy-chip" style="top:32%;left:38%;--r:3deg;">calm</span>
							<span class="tidy-chip" style="top:14%;left:62%;--r:-2deg;">breathe</span>
							<span class="tidy-chip" style="top:48%;left:16%;--r:5deg;">settle</span>
							<span class="tidy-chip" style="top:55%;left:55%;--r:-5deg;">clarity</span>
							<span class="tidy-chip" style="top:40%;left:78%;--r:2deg;">drift</span>
							<span class="tidy-chip" style="top:68%;left:32%;--r:-3deg;">rest</span>
							<span class="tidy-chip" style="top:64%;left:70%;--r:4deg;">tidy</span>
							<span class="absolute inset-x-0 bottom-6 text-center text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant/60">Click to play</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Calm vs timed -->
		<section class="px-6 md:px-12 pb-section w-full max-w-5xl mx-auto">
			<h2 class="text-2xl md:text-3xl font-extrabold mb-2">Calm games, and the ones with a clock</h2>
			<p class="text-on-surface-variant mb-6">We label every game honestly, so you can pick the mood you're in.</p>
			<div class="grid md:grid-cols-2 gap-6">
				<div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
					<h3 class="font-bold mb-3">No countdown, take your time</h3>
					<ul class="space-y-2 text-on-surface-variant">
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/tidy">Tidy</a> — clear a drifting pile of words (also in <a class="underline" href="/games/tidy-es">Español</a>, <a class="underline" href="/games/tidy-ms">Bahasa Melayu</a>, <a class="underline" href="/games/tidy-ja">日本語</a>)</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/zentype">ZenType</a> — calm typing practice</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/zentype-reverse">ZenType Reverse</a> — type backwards, slowly</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/typespace">TypeSpace</a> — quotes at your own rhythm</li>
					</ul>
				</div>
				<div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6">
					<h3 class="font-bold mb-3">Against the clock</h3>
					<ul class="space-y-2 text-on-surface-variant">
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/typefall">TypeFall</a> — falling words</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/typerush">Type Rush</a> — arcade challenge</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/vowelsplit">VowerSplit</a> — 10-second sprint</li>
						<li><a class="font-semibold text-on-surface hover:text-primary" href="/games/scrambletype">ScrambleType</a> — unscramble words</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Duolingo companion -->
		<section class="px-6 md:px-12 pb-section w-full max-w-3xl mx-auto">
			<div class="rounded-2xl border border-outline-variant bg-surface-container-low p-6 md:p-8">
				<h2 class="text-xl md:text-2xl font-extrabold mb-2">Learning a language? Tidy pairs with Duolingo.</h2>
				<p class="text-on-surface-variant leading-relaxed">Duolingo gives you structure and a push. Tidy is the opposite: no streaks, no hearts, no clock, just the words that won't stick, in <a class="underline hover:text-primary" href="/games/tidy-es">Spanish</a>, <a class="underline hover:text-primary" href="/games/tidy-ms">Malay</a> and <a class="underline hover:text-primary" href="/games/tidy-ja">Japanese</a>. Not a competitor, a companion. <a class="underline hover:text-primary" href="/blog/Duolingo_and_Tidy_20261021">Read why</a>.</p>
			</div>
		</section>

		<!-- FAQ -->
		<section class="px-6 md:px-12 pb-section w-full max-w-3xl mx-auto">
			<h2 class="text-2xl md:text-3xl font-extrabold mb-4">Questions</h2>
			<h3 class="font-bold">What is a relaxing typing game?</h3>
			<p class="text-on-surface-variant mb-4">One without a countdown or a score to beat. In Typpy's Tidy you clear a pile of words at your own pace, and nothing happens if you pause.</p>
			<h3 class="font-bold">Is there a typing game with no timer?</h3>
			<p class="text-on-surface-variant mb-4">Tidy has no clock at all. ZenType, ZenType Reverse and TypeSpace show your time for stats, but they never cut you off or count down. All are free, with no signup.</p>
			<h3 class="font-bold">Will it still make me a faster typist?</h3>
			<p class="text-on-surface-variant">Yes. Steady, low-stress practice builds accuracy and rhythm, and speed follows.</p>
		</section>
	</main>

	<script define:vars={{ GAMES: games }}>
		document.getElementById('random-game-btn')?.addEventListener('click', () => {
			if (!GAMES || !GAMES.length) { location.href = '/games'; return; }
			const idx = Math.floor(Math.random() * GAMES.length);
			location.href = GAMES[idx].href || '/games';
		});
	</script>
</Layout>

<style>
	.home {
		padding: 2rem 1.25rem;
	}

	.tidy-chip {
		position: absolute;
		transform: rotate(var(--r, 0deg));
		font: 600 14px system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		background: #fff;
		border: 1px solid rgba(150, 128, 100, 0.25);
		color: #5e4f3f;
		padding: 6px 12px;
		border-radius: 10px;
		box-shadow: 0 2px 6px rgba(110, 88, 62, 0.14);
		transition: transform 0.2s;
	}
	.tidy-preview:hover .tidy-chip {
		transform: rotate(var(--r, 0deg)) translateY(-3px);
	}
</style>
