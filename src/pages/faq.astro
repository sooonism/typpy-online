---
import Layout from '@/layouts/Layout.astro';

const title = 'FAQ — Typpy';
const description = 'Frequently asked questions about Typpy, its zen-leaning typing philosophy, game direction, updates, and contact.';
const url = 'https://typpy.online/faq';

const schema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
        {
            '@type': 'Question',
            name: 'What is Typpy?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Typpy is a mini typing game project created by Soon, a game designer and software engineer. It is built around a playful, calmer typing experience: less exam pressure, more flow and rhythm.'
            }
        },
        {
            '@type': 'Question',
            name: 'Who is behind Typpy?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Typpy is built by Soon. The project came from falling in love with typing on a small, clicky keyboard, then using software and game design skills (with some AI help) to turn that feeling into playable typing games.'
            }
        },
        {
            '@type': 'Question',
            name: 'What does “more solitaire than exam” mean?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'It means Typpy favors a calmer, more tactile vibe instead of constant timer pressure. Think rhythm, focus, and playful challenge over pure performance stress.'
            }
        },
        {
            '@type': 'Question',
            name: 'Are there still speed-focused games?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes. Typpy includes faster and score-driven modes, but the project direction also includes chill and puzzlish experiences so different typing moods are supported.'
            }
        },
        {
            '@type': 'Question',
            name: 'Will new games be added?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes. New ideas are added occasionally as the project evolves, so the lineup will keep growing over time.'
            }
        },
        {
            '@type': 'Question',
            name: 'Can I report bugs or send ideas?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Yes, please email sooonism@gmail.com if you find a bug, have a fun idea, or just want to say hi. Please do not spam.'
            }
        }
    ]
};
---

<Layout title={title} description={description} url={url} schema={schema}>
<main class="flex-grow flex flex-col items-center justify-center py-section px-6 md:px-12 w-full max-w-6xl mx-auto">
        <div class="max-w-4xl mx-auto">
            
            <section class="mb-xl">
                <div class="flex items-center gap-2 mb-lg">
                    <span class="material-symbols-outlined text-brand-red">help</span>
                    <h2 class="text-2xl font-bold uppercase tracking-tight">General Questions</h2>
                </div>
                <div class="bg-white rounded-3xl border border-outline-variant overflow-hidden shadow-sm">
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">What is Typpy?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            Typpy is a mini typing game project created by Soon, a game designer and software engineer. The core idea is simple: make typing feel fun, tactile, and human again.
                        </div>
                    </details>
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">Who is behind Typpy?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            Typpy is built by Soon. It started after buying a small keyboard with great touch and clicking sounds, then turning that typing obsession into a series of playable experiments with some AI assistance.
                        </div>
                    </details>
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">What does “more solitaire than exam” mean?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            It means a calmer approach to typing. Less constant timer pressure, less panic, more rhythm and focus. Typpy is designed to feel closer to flow than to a stressful test.
                        </div>
                    </details>
                </div>
            </section>

            <section class="mb-xl">
                <div class="flex items-center gap-2 mb-lg">
                    <span class="material-symbols-outlined text-brand-red">auto_awesome</span>
                    <h2 class="text-2xl font-bold uppercase tracking-tight">Roadmap & Support</h2>
                </div>
                <div class="bg-white rounded-3xl border border-outline-variant overflow-hidden shadow-sm">
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">Are there still speed-focused games?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            Yes. Some games are still fast and score-focused. At the same time, Typpy is expanding into more chill and puzzlish styles so you can choose the vibe you want.
                        </div>
                    </details>
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">Will new games be added?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            Yes. New games and ideas are added occasionally. The project keeps evolving as Soon experiments with new mechanics and typing moods.
                        </div>
                    </details>
                    <details class="faq-item group">
                        <summary class="flex justify-between items-center p-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                            <span class="font-bold text-on-surface">Can I report bugs or send ideas?</span>
                            <span class="material-symbols-outlined expand-icon text-outline">expand_more</span>
                        </summary>
                        <div class="px-lg pb-lg text-on-surface-variant leading-relaxed">
                            Absolutely. Email <a href="mailto:sooonism@gmail.com" class="underline underline-offset-4">sooonism@gmail.com</a> if you find a bug, have a fun idea, or just want to say hi. Please do not spam.
                        </div>
                    </details>
                </div>
            </section>
        </div>
</main>
</Layout>