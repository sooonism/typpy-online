---
import Layout from '@/layouts/Layout.astro';

const title = 'About Soon — Typpy';
const description = 'Meet Soon, the game designer and software engineer behind Typpy, and learn why these typing games aim for a calmer, more playful feel.';
const url = 'https://typpy.online/about';

const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        name: title,
        description,
        url,
        mainEntity: {
            '@type': 'Person',
            name: 'Soon'
        },
        breadcrumb: {
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
                { '@type': 'ListItem', position: 2, name: 'About', item: url }
            ]
        }
    },
    {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Soon',
        jobTitle: ['Game Designer', 'Software Engineer'],
        email: 'mailto:sooonism@gmail.com',
        url,
        sameAs: ['https://typpy.online/about'],
        description: 'Game designer and software engineer creating Typpy typing games with a playful, zen-leaning style.',
        worksFor: {
            '@type': 'Organization',
            name: 'Typpy'
        }
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://typpy.online' },
            { '@type': 'ListItem', position: 2, name: 'About', item: url }
        ]
    }
];
---

<Layout title={title} description={description} url={url} schema={schema}>
    <main class="flex-grow w-full px-6 md:px-12 py-section">
        <div class="max-w-6xl mx-auto space-y-8 md:space-y-12 pt-16 md:pt-24">
            <section class="hero-panel rounded-[2rem] overflow-hidden border border-outline-variant bg-surface-container-low">
                <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-0">
                    <div class="p-8 md:p-12 lg:p-16">
                        <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 rounded-full bg-white/80 border border-outline-variant text-primary text-label-compact uppercase tracking-[0.2em]">
                            <span class="material-symbols-outlined text-[18px]">person</span>
                            Behind Typpy
                        </div>

                        <p class="text-sm md:text-base uppercase tracking-[0.28em] text-on-surface-variant mb-4">
                            Game designer. Software engineer. Keyboard enjoyer.
                        </p>

                        <h1 class="text-5xl md:text-7xl font-black tracking-tight text-on-surface mb-6 leading-[0.95]">
                            I&apos;m <span class="text-brand-red italic">Soon</span>.
                        </h1>

                        <p class="text-lg md:text-2xl text-on-surface-variant max-w-3xl leading-relaxed mb-5">
                            I&apos;m a game designer and software engineer. Lately I bought a small keyboard with a really nice
                            touch and clicky sound, and suddenly fell in love with just typing.
                        </p>

                        <div class="quote-card rounded-[1.5rem] p-6 md:p-7 mb-8">
                            <p class="text-lg md:text-xl text-on-surface leading-relaxed">
                                So I decided to use my skills, with a little help from <span class="font-semibold text-brand-red">AI</span>,
                                to build mini typing games. That&apos;s how <span class="font-semibold">typpy.online</span> was born.
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-4 items-center">
                            <a
                                href="/games"
                                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-red text-white font-bold shadow-md hover:-translate-y-0.5 transition-transform"
                            >
                                <span class="material-symbols-outlined text-[18px]">sports_esports</span>
                                Play the games
                            </a>
                            <div class="mono inline-flex items-center px-5 py-3 rounded-xl border border-outline-variant bg-white text-on-surface-variant">
                                <span>typpy --stay-tuned</span>
                                <span class="typing-cursor"></span>
                            </div>
                        </div>
                    </div>

                    <div class="hero-side p-8 md:p-12 lg:p-16 flex items-center">
                        <div class="space-y-4 w-full">
                            <div class="mini-card rounded-[1.5rem] p-6 border border-white/40">
                                <div class="flex items-center gap-3 mb-3 text-on-surface">
                                    <span class="material-symbols-outlined text-brand-red">keyboard</span>
                                    <h2 class="text-xl font-bold">The spark</h2>
                                </div>
                                <p class="text-on-surface-variant leading-relaxed">
                                    A small keyboard with a satisfying feel and sound turned typing itself into the inspiration.
                                </p>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-4">
                                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                                    <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">Built with</p>
                                    <p class="font-semibold text-on-surface">Code, design, and a bit of AI help.</p>
                                </div>
                                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                                    <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">Direction</p>
                                    <p class="font-semibold text-on-surface">More zen, more play, less exam energy.</p>
                                </div>
                                <div class="mini-card rounded-[1.25rem] p-5 border border-white/40">
                                    <p class="text-xs uppercase tracking-[0.22em] text-on-surface-variant mb-2">Updates</p>
                                    <p class="font-semibold text-on-surface">New games will show up occasionally.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="grid lg:grid-cols-[0.92fr_1.08fr] gap-6 md:gap-8 items-start">
                <div class="section-card rounded-[2rem] p-8 md:p-10 border border-outline-variant bg-white sticky top-24">
                    <div class="inline-flex items-center gap-2 text-primary font-semibold mb-4">
                        <span class="material-symbols-outlined">self_improvement</span>
                        <span>The vibe</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-black tracking-tight text-on-surface mb-4">
                        More solitaire than exam.
                    </h2>
                    <p class="text-on-surface-variant leading-relaxed text-lg">
                        I want these typing games to feel a little more zen. I already have some faster speed-test style ideas,
                        but I&apos;m especially interested in chill, playful, and puzzlish typing games.
                    </p>
                </div>

                <div class="grid gap-5">
                    <article class="section-card rounded-[2rem] p-8 md:p-10 border border-outline-variant bg-surface-container-low">
                        <p class="text-lg md:text-xl text-on-surface leading-relaxed mb-5">
                            The more I make typing games, the more ideas keep coming.
                        </p>
                        <p class="text-on-surface-variant leading-relaxed mb-4">
                            Typpy is growing out of curiosity. Every small experiment leads to another one, so I&apos;ll keep adding
                            new games from time to time.
                        </p>
                        <p class="text-on-surface-variant leading-relaxed">
                            Some will be faster and more intense. Some will be calmer. The long-term goal is a collection that
                            feels personal instead of generic.
                        </p>
                    </article>

                    <div class="grid md:grid-cols-3 gap-5">
                        <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
                            <span class="material-symbols-outlined text-brand-red mb-3">spa</span>
                            <h3 class="font-bold text-on-surface mb-2">Chill</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">
                                Type for fun, not just for a score.
                            </p>
                        </div>
                        <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
                            <span class="material-symbols-outlined text-brand-red mb-3">extension</span>
                            <h3 class="font-bold text-on-surface mb-2">Puzzlish</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">
                                Small mechanics that make typing feel playful.
                            </p>
                        </div>
                        <div class="section-card rounded-[1.5rem] p-6 border border-outline-variant bg-white">
                            <span class="material-symbols-outlined text-brand-red mb-3">favorite</span>
                            <h3 class="font-bold text-on-surface mb-2">Personal</h3>
                            <p class="text-sm text-on-surface-variant leading-relaxed">
                                More of my own taste, not just standard drills.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <section class="maker-note rounded-[2rem] p-8 md:p-10 lg:p-12 overflow-hidden relative">
                <div class="absolute -right-6 -top-6 w-40 h-40 rounded-full bg-white/20 blur-2xl"></div>
                <div class="absolute -left-10 bottom-0 w-48 h-48 rounded-full bg-white/10 blur-3xl"></div>
                <div class="relative z-10 max-w-4xl">
                    <div class="inline-flex items-center gap-2 text-white font-semibold mb-4">
                        <span class="material-symbols-outlined">mail</span>
                        <span>A small note</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white mb-5">
                        It&apos;s still a work in progress.
                    </h2>
                    <p class="text-white/90 text-lg leading-relaxed mb-5">
                        It isn&apos;t perfect, even with AI help, so please bear with me for a bit. If you find bugs, have an idea
                        you think would be fun, or just want to say hi, email me at
                        <a class="font-semibold underline underline-offset-4" href="mailto:sooonism@gmail.com">sooonism@gmail.com</a>.
                    </p>
                    <p class="text-white/90 text-lg leading-relaxed mb-8">
                        But please don&apos;t spam me.
                    </p>

                    <div class="flex flex-wrap items-end justify-between gap-6">
                        <div>
                            <p class="text-white font-bold text-xl">Thanks for reading,</p>
                            <p class="text-white/80 italic">and happy typing.</p>
                        </div>

                        <div class="rounded-[1.25rem] border border-white/30 bg-white/10 backdrop-blur px-5 py-4 max-w-md">
                            <p class="text-xs uppercase tracking-[0.22em] text-white/70 mb-2">Contact</p>
                            <p class="text-white/90 leading-relaxed">
                                Bugs, ideas, or a simple hello are welcome.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
    }

    .mono {
        font-family: 'JetBrains Mono', 'JetBrains+Mono', monospace;
    }

    .typing-cursor {
        display: inline-block;
        width: 10px;
        height: 20px;
        background-color: #e60023;
        margin-left: 6px;
        border-radius: 2px;
        animation: blink 1s infinite;
    }

    .hero-panel {
        background:
            radial-gradient(circle at top right, rgba(230, 0, 35, 0.12), transparent 28%),
            linear-gradient(135deg, #fff8f7 0%, #fff0ef 100%);
    }

    .hero-side {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.88) 100%),
            linear-gradient(160deg, rgba(230, 0, 35, 0.08) 0%, rgba(183, 0, 26, 0.02) 100%);
    }

    .mini-card,
    .section-card,
    .quote-card {
        box-shadow: 0 10px 30px -24px rgba(42, 22, 21, 0.24);
    }

    .quote-card {
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(232, 188, 184, 0.9);
        backdrop-filter: blur(10px);
    }

    .section-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .section-card:hover {
        transform: translateY(-2px);
        border-color: #e60023;
        box-shadow: 0 18px 40px -30px rgba(183, 0, 26, 0.5);
    }

    .maker-note {
        background:
            radial-gradient(circle at top right, rgba(255, 255, 255, 0.25), transparent 24%),
            linear-gradient(135deg, #b7001a 0%, #e60023 55%, #ff5c75 140%);
    }

    @keyframes blink {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
</style>