---
import Footer from '@/components/footer.astro';
import MobileNav from '@/components/mobile-nav.astro';
import { primaryNavLinks } from '@/data/site-links';
import '../styles/global.css';

const {
  title = "Typpy – Happy Typing",
  description = "Typpy — happy typing. Play Typpy, a fun typing game to prevent brain decline and improve speed, accuracy, and real-world typing skills.",
    url = null,
  image = "https://typpy.online/og/default.png",
  type = "website",
  schema = null,
  keywords = '',
  genre = null,
  releaseDate = null,
  developer = null,
  publisher = null,
    platform = 'Web',
    noindex = false
} = Astro.props;

const site = 'https://typpy.online';
const pathname = (Astro.url?.pathname || '/').replace(/\/+$/, '') || '/';
const canonicalUrl = url || new URL(pathname, site).toString();
---

<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <!-- Basic SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OpenGraph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Typpy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@typpy" />
    <meta name="twitter:creator" content="@typpy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {keywords && <meta name="keywords" content={keywords} />}
    {genre && <meta name="genre" content={genre} />}
    {releaseDate && <meta property="article:published_time" content={releaseDate} />}
    {platform && <meta name="application-name" content={platform} />}
    {developer && <meta name="author" content={developer} />}
    {publisher && <meta name="publisher" content={publisher} />}
    <meta name="google-adsense-account" content="ca-pub-8247702837370777">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="shortcut icon" href="/favicon.svg">
<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- google adsense -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8247702837370777"
     crossorigin="anonymous"></script>
     <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-FKXKL01WVD"></script>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-NZ98P4KK');</script>
<!-- End Google Tag Manager -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-FKXKL01WVD');
</script>
<!-- Tailwind is now built locally; remove CDN usage in production -->
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        /* Custom utilities for the typing area to ensure perfect rendering */
        .typing-text {
            word-spacing: 0.25em;
            letter-spacing: -0.01em;
        }
    </style>
    <script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Typpy",
  "url": "https://typpy.online",
  "logo": "https://typpy.online/logo.svg",
  "description": "Typpy — happy typing"
})}
    </script>
    {schema && (
      <script type="application/ld+json">
{JSON.stringify(schema)}
      </script>
    )}
</head>
<body class="bg-background min-h-screen flex flex-col font-body text-body text-on-background selection:bg-brand-red selection:text-on-primary-container">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NZ98P4KK"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <!-- TopNavBar -->
<header class="sticky top-0 w-full z-50 bg-header-cream border-b border-warm-silver/20">
<div class="flex justify-between items-center h-16 px-8 w-full max-w-7xl mx-auto font-['Plus_Jakarta_Sans'] text-sm font-medium tracking-tight">
<!-- Brand -->
<a class="text-2xl font-black text-brand-red tracking-tighter" href="/"><img src="/logo.svg" alt="Typpy Logo" width="140"></a>
<!-- Navigation Links (Desktop) -->
<nav id="top-nav" class="hidden md:flex items-center gap-8">
        {primaryNavLinks.map(link => (
            <a class="nav-link text-olive-gray hover:text-dark-surface transition-colors pb-1 border-b-2 border-transparent" href={link.href}>{link.label}</a>
        ))}
</nav>
<!-- Mobile nav (mobile only) -->
<MobileNav />
<!-- Trailing Actions -->
</div>
</header>
<script is:inline>
    (function () {
        const nav = document.getElementById('top-nav');
        if (!nav) return;
        const currentPath = (location && location.pathname) ? (location.pathname.replace(/\/+$/, '') || '/') : '/';
        nav.querySelectorAll('a.nav-link').forEach(a => {
            const href = a.getAttribute('href') || '';
            const linkPath = (new URL(href, location.origin).pathname || '/').replace(/\/+$/, '') || '/';
            if (linkPath === currentPath) {
                a.classList.add('text-brand-red', 'border-brand-red');
                a.classList.remove('text-olive-gray', 'border-transparent');
                a.setAttribute('aria-current', 'page');
            } else {
                a.classList.remove('text-brand-red', 'border-brand-red');
                a.classList.add('text-olive-gray', 'border-transparent');
                a.removeAttribute('aria-current');
            }
        });
    })();
</script>
<slot />
<Footer />
</body>
</html>

